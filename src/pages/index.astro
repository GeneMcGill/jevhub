---
import Base from "../layouts/Base.astro";
const projects = (await import("../data/projects.json")).default;
const CATS = ["All", "AI", "Developer tools", "Design", "Motion", "Productivity", "Consumer", "Hardware", "Other"];
---
<Base>
  <section class="hero">
    <h1>Discover project launches from the Jev ecosystem</h1>
    <p class="sub">A curated edit of product launches, demos, and walkthroughs from System-1 / TypeSafe Jev projects introducing new work to the world.</p>
  </section>
  <section class="chips" id="chips">
    {CATS.map((c, i) => <button class={i === 0 ? "on" : ""} data-cat={c}>{c}</button>)}
  </section>
  <div class="count" id="count">{projects.length} videos</div>
  <div id="grid">
    {projects.map((p, i) => (
      <a class="card" data-cat={p.ws_cat} href={`/videos/${p.slug}/`}>
        <div class="poster" data-hue={i % 4}>
          <span>{p.name[0].toUpperCase()}</span>
          {p.views ? <span class="views">{p.views}</span> : null}
          {p.dur && <span class="dur">{p.dur}</span>}
        </div>
        <div class="body">
          <div class="handle">@{p.github.split("github.com/")[1]}</div>
          <h3>{p.name}</h3>
          <div class="row2">
            <span>{(p.name.split(/[-\s]/)[0] || "Jev")}</span>
            <span>·</span><span>{p.ws_cat}</span>
            <span>·</span><span>{p.added}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
  <script>
    const btns = document.querySelectorAll("#chips button");
    const count = document.getElementById("count");
    function apply(cat) {
      let n = 0;
      document.querySelectorAll(".card").forEach(c => {
        const show = cat === "All" || c.dataset.cat === cat;
        c.style.display = show ? "" : "none";
        if (show) n++;
      });
      if (count) count.textContent = n + " videos";
    }
    btns.forEach(b => (b.onclick = () => {
      btns.forEach(x => x.classList.remove("on"));
      b.classList.add("on");
      apply(b.dataset.cat);
    }));
  </script>
</Base>
